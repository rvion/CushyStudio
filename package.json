        "cross-env": "^7.0.3",
        "electron-devtools-installer": "^4.0.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-react-refresh": "^0.4.19",
        "eslint-plugin-tailwindcss": "^3.18.0",
