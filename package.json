        "@types/mime-types": "^2.1.4",
        "@types/node": "22.13.10",
        "@types/offscreencanvas": "^2019.7.3",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@types/three": "^0.174.0",
        "@types/ws": "^8.18.0",
